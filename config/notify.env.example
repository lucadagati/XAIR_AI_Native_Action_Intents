# Telegram notifications for long-running campaigns.
# Copy to config/notify.env (gitignored) and fill in. Never commit the real token.
#
#   cp config/notify.env.example config/notify.env
#   # message your bot once, then:
#   python3 scripts/notify.py --discover
#   python3 scripts/notify.py --test

export TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
# Filled in by --discover, or copy it from https://api.telegram.org/bot<TOKEN>/getUpdates
export TELEGRAM_CHAT_ID=

# Optional: prefix every message, useful when several machines report to one chat.
export NOTIFY_PREFIX=adaptix
# Set to 0 to silence notifications without editing call sites.
export NOTIFY_ENABLED=1
